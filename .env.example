# ========================================================
# Vani Technologies - Environment Configuration Template
# Copy this file to .env and configure for your environment.
# DO NOT commit the .env file containing real secrets.
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://www.vanitechnologies.in

# Database Configuration (MongoDB Atlas or Self-Hosted)
# Example Local: mongodb://127.0.0.1:27017/vani_technologies
# Example Atlas: mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/vani_technologies?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster.mongodb.net/vani_technologies?retryWrites=true&w=majority

# Authentication & Security
# Generate a strong 64+ character secret (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_ultra_secure_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# OTP & Phone Verification
# Set to 'false' in production when real SMS gateway is connected.
# Set to 'true' in development to mock OTP generation without SMS charges.
MOCK_OTP=false
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your_twilio_account_sid_here
SMS_AUTH_TOKEN=your_twilio_auth_token_here
SMS_SENDER_NUMBER=+1234567890

# SMTP / Email Service Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_smtp_password_here
FROM_EMAIL=support@vanitechnologies.in
FROM_NAME=Vani Technologies

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
