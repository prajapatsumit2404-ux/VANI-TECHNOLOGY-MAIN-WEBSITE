# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Replace with your local or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/vani_technologies

# Authentication Secret (Change this to a strong random key in production)
JWT_SECRET=vani_technologies_super_secret_jwt_key_2026

# Email Configuration (Optional - for real email verification)
EMAIL_SERVICE=gmail
EMAIL_USER=support@vanitechnologies.in
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM="Vani Technologies <support@vanitechnologies.in>"

# SMS Configuration (Optional - for real SMS OTP in production)
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=VANITEC

# OTP Mode: 'true' uses development mock OTP (printed to console), 'false' uses real SMS
MOCK_OTP=true
